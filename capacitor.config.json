{
  "appId": "com.rooom.talk",
  "appName": "RoooM Talk",
  "webDir": "dist",
  "server": {
    "url": "https://rooom-talk.com",
    "cleartext": false
  },
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "sound"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
